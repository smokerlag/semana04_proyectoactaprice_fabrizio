<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paso 3: Verificación Obligatoria"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Pregunta 1 -> Incumplimiento 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. ¿Teléfono publicado en el establecimiento?"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>
        <RadioGroup
            android:id="@+id/rgTelefonoPublicado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbTelPubSi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sí" />
            <RadioButton android:id="@+id/rbTelPubNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="No" />
        </RadioGroup>

        <!-- Pregunta 2 -> Incumplimiento 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. ¿Teléfono registrado y actualizado en PRICE?"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>
        <RadioGroup
            android:id="@+id/rgTelefonoActualizado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbTelActSi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sí" />
            <RadioButton android:id="@+id/rbTelActNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="No" />
        </RadioGroup>

        <!-- Pregunta 3 -> Incumplimiento 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. ¿Horario de atención publicado en el local?"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>
        <RadioGroup
            android:id="@+id/rgHorarioPublicado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbHorPubSi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sí" />
            <RadioButton android:id="@+id/rbHorPubNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="No" />
        </RadioGroup>

        <!-- Pregunta 4 -> Incumplimiento 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. ¿Se exhibe la lista de precios vigente?"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>
        <RadioGroup
            android:id="@+id/rgListaPrecios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbListaSi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sí" />
            <RadioButton android:id="@+id/rbListaNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="No" />
        </RadioGroup>

        <!-- Pregunta 5 -> Incumplimiento 5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. ¿Se emplea el galón como unidad de medida?"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>
        <RadioGroup
            android:id="@+id/rgUnidadMedida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbUnidadSi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sí" />
            <RadioButton android:id="@+id/rbUnidadNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="No" />
        </RadioGroup>

        <!-- Pregunta 6 -> Incumplimiento 6 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6. ¿Cuenta con etiqueta visible de precio por galón?"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>
        <RadioGroup
            android:id="@+id/rgEtiquetaPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbEtiquetaSi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sí" />
            <RadioButton android:id="@+id/rbEtiquetaNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="No" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSiguiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Siguiente: Incumplimientos" />

    </LinearLayout>
</ScrollView>
