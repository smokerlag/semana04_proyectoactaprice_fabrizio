{
  "info": {
    "_postman_id": "a1b2c3d4-acta-price-2026",
    "name": "Acta PRICE API",
    "description": "Colección de pruebas para la API REST del proyecto Acta PRICE.\n\nBase URL: http://localhost:3000\n\nAuth: primero ejecuta Login OK (guarda {{token}}). Los endpoints de establecimientos/fiscalizaciones requieren Authorization: Bearer {{token}}.\n\nUsuarios:\n- admin / admin123\n- fiscalizador / price2026",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "establecimientoId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health (público)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Auth - Login OK",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test('Tiene token', function () { pm.expect(j.token).to.be.a('string'); });",
              "if (j.token) pm.collectionVariables.set('token', j.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"fiscalizador\",\n  \"password\": \"price2026\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Auth - Login inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"x\",\n  \"password\": \"y\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Establecimientos - Sin token (debe 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401 sin token', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/establecimientos"
      }
    },
    {
      "name": "Establecimientos - Listar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Es array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/establecimientos"
      }
    },
    {
      "name": "Establecimientos - Crear",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();",
              "if (j.id) pm.collectionVariables.set('establecimientoId', String(j.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"GRIFO POSTMAN DEMO\",\n  \"ruc\": \"20999888777\",\n  \"direccion\": \"AV. PRUEBA 456\",\n  \"telefono\": \"150999\",\n  \"ubigeo\": \"LIMA-LIMA-SAN ISIDRO\",\n  \"actividad\": \"GRIFO\",\n  \"nroRegistro\": \"RH-9999\",\n  \"fechaEmision\": \"10/09/2026\",\n  \"placaPrincipal\": \"\",\n  \"sincronizado\": false\n}"
        },
        "url": "{{baseUrl}}/establecimientos"
      }
    },
    {
      "name": "Fiscalizaciones - Listar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/fiscalizaciones"
      }
    },
    {
      "name": "Fiscalizaciones - Registrar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Tiene id', function () { pm.expect(pm.response.json().id).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"establecimientoId\": {{establecimientoId}},\n  \"expediente\": \"EXP-2026-001\",\n  \"agenteFiscalizado\": \"GRIFO POSTMAN DEMO\",\n  \"codigoOsinergmin\": \"150999\",\n  \"registroHidrocarburos\": \"RH-9999\",\n  \"fechaDiligencia\": \"10/09/2026\",\n  \"horaApertura\": \"09:00\",\n  \"horaCierre\": \"10:30\",\n  \"direccion\": \"AV. PRUEBA 456\",\n  \"distrito\": \"SAN ISIDRO\",\n  \"provincia\": \"LIMA\",\n  \"departamento\": \"LIMA\",\n  \"rucDni\": \"20999888777\",\n  \"telefonoFax\": \"014445566\",\n  \"fiscalizadorResponsable\": \"FISCALIZADOR DEMO\",\n  \"productosJson\": \"[{\\\"nombre\\\":\\\"Diesel B5 S-50\\\",\\\"precioPrice\\\":\\\"12.50\\\",\\\"precioPublicado\\\":\\\"12.50\\\",\\\"precioSurtidor\\\":\\\"12.45\\\",\\\"precioDescuento\\\":\\\"12.00\\\"}]\",\n  \"telefonoPublicado\": \"Sí\",\n  \"telefonoActualizado\": \"Sí\",\n  \"horarioPublicado\": \"Sí\",\n  \"listaPreciosExhibida\": \"Sí\",\n  \"unidadGalonEmpleada\": \"Sí\",\n  \"etiquetaVisible\": \"Sí\",\n  \"incumplimientosJson\": \"[]\",\n  \"hechosVerificados\": \"[{\\\"incumplimientoNombre\\\":\\\"Observación General\\\",\\\"hechoRedactado\\\":\\\"Sin hallazgos relevantes\\\"}]\",\n  \"documentacion\": \"Lista de precios fotografiada\",\n  \"ocurrencias\": \"Ninguna\",\n  \"observaciones\": \"Conforme\",\n  \"negativaFirma\": false,\n  \"estado\": \"ACTA GENERADA\",\n  \"sincronizado\": false\n}"
        },
        "url": "{{baseUrl}}/fiscalizaciones"
      }
    }
  ]
}
